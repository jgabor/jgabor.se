---
---

<section class="relative py-24 md:py-36" id="contact">
  <div class="relative mx-auto max-w-[1100px] px-6 md:px-8">
    <div class="grid gap-16 md:grid-cols-[200px_1fr]">
      <div>
        <span class="eyebrow">Contact</span>
        <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-foreground md:text-4xl">Get in touch</h2>
      </div>
      <form class="fade-in flex max-w-lg flex-col gap-5" id="contact-form">
        <div>
          <label
            for="contact-email"
            class="mb-2 block font-mono text-xs uppercase tracking-[0.15em] text-muted"
          >
            Email
          </label>
          <input
            type="email"
            id="contact-email"
            name="from"
            required
            placeholder="you@company.com"
            class="w-full border border-overlay/12 bg-surface px-4 py-3 font-sans text-base text-foreground placeholder-muted/40 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/40"
          />
        </div>
        <div>
          <label
            for="contact-message"
            class="mb-2 block font-mono text-xs uppercase tracking-[0.15em] text-muted"
          >
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            placeholder="What's on your mind?"
            class="min-h-[140px] w-full resize-none border border-overlay/12 bg-surface px-4 py-3 font-sans text-base text-foreground placeholder-muted/40 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/40"
          ></textarea>
        </div>
        <button
          type="submit"
          id="submit-btn"
          class="self-start border border-foreground bg-foreground px-8 py-3 font-mono text-sm uppercase tracking-[0.15em] text-surface transition-all hover:bg-transparent hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:opacity-50 cursor-pointer"
        >
          Send message
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  contactForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";

    const emailInput = document.getElementById("contact-email") as HTMLInputElement;
    const messageInput = document.getElementById("contact-message") as HTMLTextAreaElement;

    fetch("/api/contact", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        from: emailInput.value,
        message: messageInput.value,
      }),
    })
      .then((res) => {
        if (!res.ok) throw new Error("Failed");
        submitBtn.textContent = "Sent!";
        contactForm.reset();
        setTimeout(() => {
          submitBtn.textContent = "Send message";
          submitBtn.disabled = false;
        }, 3000);
      })
      .catch(() => {
        submitBtn.textContent = "Failed — try again";
        setTimeout(() => {
          submitBtn.textContent = "Send message";
          submitBtn.disabled = false;
        }, 3000);
      });
  });
</script>
