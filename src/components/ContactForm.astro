---
---

<section class="relative py-24 md:py-36" id="contact">
  <div class="pointer-events-none absolute left-4 top-8 select-none font-mono text-[clamp(6rem,20vw,18rem)] font-bold leading-none opacity-[0.03] md:left-8">
    03
  </div>
  <div class="relative mx-auto max-w-[1100px] px-6 md:px-8">
    <div class="grid gap-16 md:grid-cols-[200px_1fr]">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-gray-500">Contact</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white md:text-4xl">Get in touch</h2>
      </div>
      <form class="fade-in flex max-w-lg flex-col gap-5" id="contact-form">
        <div>
          <label
            for="contact-email"
            class="mb-2 block font-mono text-xs uppercase tracking-[0.15em] text-gray-500"
          >
            Email
          </label>
          <input
            type="email"
            id="contact-email"
            name="from"
            required
            placeholder="you@company.com"
            class="w-full border border-white/[0.12] bg-black px-4 py-3 font-sans text-base text-white placeholder-gray-500/40 transition-colors focus:border-white/30 focus:outline-none"
          />
        </div>
        <div>
          <label
            for="contact-message"
            class="mb-2 block font-mono text-xs uppercase tracking-[0.15em] text-gray-500"
          >
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            placeholder="What's on your mind?"
            class="min-h-[140px] w-full resize-none border border-white/[0.12] bg-black px-4 py-3 font-sans text-base text-white placeholder-gray-500/40 transition-colors focus:border-white/30 focus:outline-none"
          ></textarea>
        </div>
        <button
          type="submit"
          id="submit-btn"
          class="self-start border border-white bg-white px-8 py-3 font-mono text-sm uppercase tracking-[0.15em] text-black transition-all hover:bg-transparent hover:text-white disabled:cursor-not-allowed disabled:opacity-50 cursor-pointer"
        >
          Send
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  contactForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";

    const emailInput = document.getElementById("contact-email") as HTMLInputElement;
    const messageInput = document.getElementById("contact-message") as HTMLTextAreaElement;

    fetch("/api/contact", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        from: emailInput.value,
        message: messageInput.value,
      }),
    })
      .then((res) => {
        if (!res.ok) throw new Error("Failed");
        submitBtn.textContent = "Sent";
        contactForm.reset();
        setTimeout(() => {
          submitBtn.textContent = "Send";
          submitBtn.disabled = false;
        }, 3000);
      })
      .catch(() => {
        submitBtn.textContent = "Error";
        setTimeout(() => {
          submitBtn.textContent = "Send";
          submitBtn.disabled = false;
        }, 3000);
      });
  });
</script>
