---
interface Props {
  experiences: Array<{
    company: string;
    tenure?: string;
    location?: string;
    roles: Array<{
      title: string;
      period: string;
      location?: string;
      description: string[];
    }>;
  }>;
}

const { experiences } = Astro.props;

const sorted = [...experiences].reverse();
const barHeights = [80, 120, 160, 220, 300];
---

<div class="fade-in">
  <div class="timeline-chart mb-16 hidden lg:block">
    <div class="timeline-row timeline-annotations">
      {sorted.map((exp, i) => (
        <div class="timeline-col">
          <div class="timeline-stars" aria-hidden="true">
            {Array.from({ length: i + 1 }).map(() => (
              <svg width="8" height="8" class="text-foreground"><use href="#glyph-triangle" /></svg>
            ))}
          </div>
          <svg width="10" height="10" class="text-foreground" aria-hidden="true"><use href="#glyph-plus" /></svg>
        </div>
      ))}
    </div>

    <div class="timeline-row timeline-bars">
      {sorted.map((exp, i) => (
        <div class="timeline-col">
          <div class="timeline-bar-stack">
            <div class="timeline-index schematic-border">
              {String(sorted.length - i).padStart(2, "0")}
            </div>
            <div
              class="stepped-bar w-full"
              style={`height: ${barHeights[i]}px`}
            ></div>
          </div>
        </div>
      ))}
    </div>

    <div class="timeline-row timeline-labels">
      {sorted.map((exp) => (
        <div class="timeline-col">
          <h3 class="font-display text-sm uppercase tracking-wide">{exp.company}</h3>
          <div class="timeline-tenure">
            {exp.tenure && <span class="type-tag">{exp.tenure}</span>}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="mb-16 flex flex-col gap-8 lg:hidden">
    {sorted.map((exp, i) => (
      <div class="flex gap-4">
        <div class="flex flex-col items-center">
          <div class="timeline-index schematic-border shrink-0">
            {String(sorted.length - i).padStart(2, "0")}
          </div>
          <div
            class="stepped-bar w-3"
            style={`height: ${barHeights[i]}px`}
          ></div>
        </div>
        <div class="min-w-0 flex-1 border-t border-foreground pt-3">
          <h3 class="font-display text-lg uppercase tracking-wide">{exp.company}</h3>
          {exp.tenure && (
            <span class="type-tag mt-2 inline-block">{exp.tenure}</span>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="flex flex-col gap-16">
    {experiences.map((exp) => (
      <div>
        <div class="mb-6 flex flex-wrap items-baseline gap-4">
          <h3 class="font-display text-2xl uppercase tracking-wide">{exp.company}</h3>
          {exp.tenure && (
            <span class="type-tag">{exp.tenure}</span>
          )}
        </div>
        <div class="flex flex-col gap-8 border-l border-foreground pl-6 md:pl-10">
          {exp.roles.map((role) => (
            <div class="grid gap-2 md:grid-cols-[minmax(220px,auto)_1fr]">
              <div class="min-w-0">
                <p class="font-mono text-xs uppercase tracking-[0.1em] text-muted">{role.period}</p>
                {(role.location ?? exp.location) && (
                  <p class="mt-1 font-mono text-xs tracking-[0.02em] text-muted">
                    {role.location ?? exp.location}
                  </p>
                )}
              </div>
              <div>
                <h4 class="text-base font-semibold">{role.title}</h4>
                {role.description.map((p) => (
                  <p class="mt-2 text-base leading-relaxed text-foreground">{p}</p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
