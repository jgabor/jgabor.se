---
import CareerTimeline from "./CareerTimeline.astro";
import SectionShell from "./SectionShell.astro";

interface Props {
  entries: Array<{
    company: string;
    tenure?: string;
    location?: string;
    roles: Array<{
      title: string;
      period: string;
      location?: string;
      description: string[];
    }>;
  }>;
}

const { entries } = Astro.props;

const skills = [
  "Product Strategy",
  "Product Vision",
  "Product Roadmap",
  "Platform Engineering",
  "Artificial Intelligence",
  "Developer Experience",
  "Software Development Lifecycle",
  "Infrastructure-as-Code",
  "Backlog Management",
  "User Research",
  "Agile Methodologies",
];

const strengths = [
  {
    title: "Systems thinking",
    description:
      "Connects immediate decisions to long-term outcomes. Sees several steps ahead without losing sight of today.",
  },
  {
    title: "Team enabler",
    description:
      "Leads by enabling others \u2014 aligning teams toward a shared north star without needing formal authority.",
  },
  {
    title: "Quick study",
    description:
      "Active listener with high-bandwidth information intake. New concepts stick quickly.",
  },
];
---

<SectionShell
  id="career"
  eyebrow="Career"
  title="15+ years building products"
  subtitle="I am relentless about creating intuitive and simple products in complex technical environments, with users' needs at the forefront."
  showConnector
  connectedTop
>
  <div class="mb-16 grid gap-4 md:grid-cols-3">
    {strengths.map((s) => (
      <div class="career-strength fade-in">
        <h3 class="font-mono text-xs uppercase tracking-[0.15em] text-muted">{s.title}</h3>
        <p class="mt-3 text-base leading-relaxed">{s.description}</p>
      </div>
    ))}
  </div>

  <div class="mb-12 fade-in">
    <p class="mb-4 font-mono text-xs uppercase tracking-[0.15em] text-muted">Skills</p>
    <div class="career-skills flex flex-wrap gap-2">
      {skills.map((skill) => (
        <span class="chip">{skill}</span>
      ))}
    </div>
  </div>

  <CareerTimeline entries={entries} />
</SectionShell>
