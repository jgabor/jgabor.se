---
import CareerTimeline from "./CareerTimeline.astro";
import SectionShell from "./SectionShell.astro";
import { homeCopy } from "../data/home-copy";

interface Props {
  entries: Array<{
    company: string;
    tenure?: string;
    location?: string;
    roles: Array<{
      title: string;
      period: string;
      location?: string;
      description: string[];
    }>;
  }>;
}

const { entries } = Astro.props;

const { eyebrow, title, subtitle, strengths, skills } = homeCopy.career;
---

<SectionShell
  id="career"
  eyebrow={eyebrow}
  title={title}
  subtitle={subtitle}
  showConnector
  connectedTop
>
  <div class="mb-16 grid gap-4 md:grid-cols-3">
    {strengths.map((s) => (
      <div class="career-strength fade-in">
        <h3 class="font-mono text-xs uppercase tracking-[0.15em] text-muted">{s.title}</h3>
        <p class="mt-3 text-base leading-relaxed">{s.description}</p>
      </div>
    ))}
  </div>

  <div class="mb-12 fade-in">
    <p class="mb-4 font-mono text-xs uppercase tracking-[0.15em] text-muted">Skills</p>
    <div class="career-skills flex flex-wrap gap-2">
      {skills.map((skill) => (
        <span class="chip">{skill}</span>
      ))}
    </div>
  </div>

  <CareerTimeline entries={entries} />
</SectionShell>
