---
import { formatTenureCompact, scaleBarHeights, tenureRanks } from "../utils/career-tenure";

interface CareerEntry {
  company: string;
  tenure?: string;
}

interface Props {
  entries: CareerEntry[];
}

const { entries } = Astro.props;

const fills = ["url(#halftone)", "currentColor", "url(#hatch-vert)", "currentColor", "url(#hatch-diag)"];
const chartPadX = 16;
const chartWidth = 488;
const baseY = 248;
const peakH = 12;
const minBarH = 48;
const maxBarH = 216;
const badgeH = 26;
const capTickH = 5;

const tenures = entries.map((entry) => entry.tenure ?? "");
const barHeights = scaleBarHeights(tenures, minBarH, maxBarH);
const ranks = tenureRanks(tenures);
const colWidth = chartWidth / entries.length;
const barW = Math.min(76, Math.floor(colWidth * 0.68));
const chartRight = chartPadX + chartWidth;
const headroom = 56;
---

<figure
  class="career-chart"
  style={`--career-chart-cols: ${entries.length}`}
  aria-label="Career timeline by company tenure"
>
  <svg
    class="career-chart-svg"
    viewBox={`0 -${headroom} 520 ${baseY + headroom + 4}`}
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <line x1={chartPadX} y1={baseY} x2={chartRight} y2={baseY} stroke="currentColor" stroke-width="1.5" />

    {
      entries.map((entry, i) => {
        const h = barHeights[i];
        const cx = chartPadX + colWidth * i + colWidth / 2;
        const x = cx - barW / 2;
        const top = baseY - h;
        const tenureLabel = formatTenureCompact(entry.tenure ?? "");
        const badgeW = Math.max(36, tenureLabel.length * 6.5 + 14);
        const capW = badgeW + 12;
        const capY = -(badgeH + 10);
        const badgeY = -(badgeH + 2);
        const rank = ranks[i];
        const fill = fills[i % fills.length];
        return (
          <g class="chart-col" style={`--col-i: ${i}`}>
            <g class="chart-col-bar">
              <rect x={x} y={top} width={barW} height={h} fill={fill} />
              <polygon
                points={`${x},${top} ${cx},${top - peakH} ${x + barW},${top}`}
                fill={fill}
              />
              <line x1={x} y1={top} x2={x + barW} y2={top} stroke="var(--ef-gray)" stroke-width="0.75" />
            </g>

            <g class="chart-col-cap" transform={`translate(${cx}, ${top - peakH})`}>
              <line
                x1={-capW / 2}
                y1={capY}
                x2={capW / 2}
                y2={capY}
                stroke="currentColor"
                stroke-width="0.75"
              />
              {
                Array.from({ length: rank }).map((_, tick) => {
                  const spacing = capW / (rank + 1);
                  const tx = -capW / 2 + spacing * (tick + 1);
                  return (
                    <line
                      x1={tx}
                      y1={capY}
                      x2={tx}
                      y2={capY - capTickH}
                      stroke="currentColor"
                      stroke-width="0.75"
                    />
                  );
                })
              }
              <line
                x1={0}
                y1={0}
                x2={0}
                y2={badgeY + badgeH}
                stroke="currentColor"
                stroke-width="0.5"
                stroke-dasharray="2 3"
              />
              <rect
                x={-badgeW / 2}
                y={badgeY}
                width={badgeW}
                height={badgeH}
                fill="var(--ef-white)"
                stroke="currentColor"
                stroke-width="1"
              />
              <text
                x={0}
                y={badgeY + badgeH / 2}
                text-anchor="middle"
                dominant-baseline="middle"
                class="career-chart-tenure"
              >
                {tenureLabel}
              </text>
            </g>
          </g>
        );
      })
    }

  </svg>

  <figcaption class="career-chart-labels">
    {entries.map((entry) => (
      <div class="career-chart-label">
        <p class="career-chart-company">{entry.company}</p>
        {entry.tenure && <span class="type-tag">{entry.tenure}</span>}
      </div>
    ))}
  </figcaption>
</figure>
