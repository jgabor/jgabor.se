---
interface Props {
  title: string;
  type: string;
  typeColor: string;
  description: string;
  tags: string[];
  url?: string;
}

const { title, type, typeColor, description, tags, url } = Astro.props;

const colorMap: Record<string, string> = {
  accent: "text-accent",
  teal: "text-accent-teal",
  violet: "text-accent-violet",
  emerald: "text-accent-emerald",
  sky: "text-accent-sky",
};

const typeColorClass = colorMap[typeColor] || colorMap.accent;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex w-[300px] flex-shrink-0 snap-start flex-col justify-between border border-overlay/12 bg-card p-6 no-underline transition-all hover:border-overlay/20 hover:bg-card/80 md:w-[340px] md:min-h-[380px]"
>
  <div>
    <div class="flex items-start justify-between">
      <h3 class="text-xl font-bold text-foreground">{title}</h3>
      <svg
        class="text-muted opacity-0 transition-opacity group-hover:opacity-100"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M15 3h6v6" />
        <path d="M10 14 21 3" />
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
      </svg>
    </div>
    <p class:list={["mt-2 font-mono text-xs uppercase tracking-[0.15em]", typeColorClass]}>
      {type}
    </p>
    <p class="mt-4 text-base leading-relaxed text-muted">{description}</p>
  </div>
  <div class="mt-6 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="border border-overlay/12 bg-secondary px-2.5 py-1 font-mono text-xs uppercase tracking-[0.05em] text-secondary-fg">
        {tag}
      </span>
    ))}
  </div>
</a>
