---
interface Props {
  title: string;
  type: string;
  typeColor: string;
  description: string;
  tags: string[];
  url?: string;
}

const { title, type, typeColor, description, tags, url } = Astro.props;

const colorMap: Record<string, string> = {
  accent: "text-[hsl(187,72%,55%)]",
  teal: "text-[hsl(168,65%,45%)]",
  violet: "text-[hsl(263,70%,58%)]",
  emerald: "text-[hsl(155,60%,45%)]",
  sky: "text-[hsl(199,89%,55%)]",
};

const typeColorClass = colorMap[typeColor] || colorMap.accent;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex w-[300px] flex-shrink-0 snap-start flex-col justify-between border border-white/[0.12] bg-[hsl(0,0%,3%)] p-6 no-underline transition-all hover:border-white/20 hover:bg-[rgba(8,8,8,0.8)] md:w-[340px] md:min-h-[380px]"
>
  <div>
    <div class="flex items-start justify-between">
      <h3 class="text-xl font-bold text-white">{title}</h3>
      <svg
        class="text-gray-500 opacity-0 transition-opacity group-hover:opacity-100"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M15 3h6v6" />
        <path d="M10 14 21 3" />
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
      </svg>
    </div>
    <p class:list={["mt-2 font-mono text-xs uppercase tracking-[0.15em]", typeColorClass]}>
      {type}
    </p>
    <p class="mt-4 text-base leading-relaxed text-gray-500">{description}</p>
  </div>
  <div class="mt-6 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="border border-white/[0.12] bg-[hsl(0,0%,8%)] px-2.5 py-1 font-mono text-xs uppercase tracking-[0.05em] text-[hsl(0,0%,70%)]">
        {tag}
      </span>
    ))}
  </div>
</a>
