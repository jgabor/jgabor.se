---
interface Props {
  index: number;
  title: string;
  type: string;
  description: string;
  tags: string[];
  url?: string;
}

const { index, title, type, description, tags, url } = Astro.props;
const number = String(index).padStart(2, "0");
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="project-row group"
>
  <div class="project-marker">
    <div class="project-number">{number}</div>
    <svg width="16" height="16" class="text-foreground" aria-hidden="true">
      <use href="#glyph-circle-plus" />
    </svg>
  </div>

  <div>
    <h3 class="font-display text-xl uppercase tracking-wide text-foreground md:text-2xl">
      {title}
    </h3>
    <span class="type-tag mt-2 inline-block">{type}</span>
  </div>

  <div>
    <p class="text-base leading-relaxed text-foreground">{description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="chip">{tag}</span>
      ))}
    </div>
  </div>
</a>
