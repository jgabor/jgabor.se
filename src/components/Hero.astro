---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/jgabor.jpg';
---

<section class="relative min-h-screen overflow-hidden pt-20">
  <div class="pointer-events-none absolute left-0 top-[8vh] select-none px-4 md:top-[12vh] md:px-8">
    <h1 class="font-sans text-[15vw] font-black uppercase leading-[0.85] tracking-tighter text-foreground md:text-[13vw]">
      Jonathan<br />Gabor
    </h1>
  </div>
  <div class="relative mx-auto flex min-h-[calc(100vh-5rem)] max-w-[1100px] flex-col justify-end px-6 pb-16 md:flex-row md:items-end md:justify-between md:px-8 md:pb-24">
    <div class="relative z-10 max-w-md">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">
        Speaks code, ships product.
      </p>
      <p class="mt-3 text-lg leading-relaxed text-foreground/80 md:text-xl">
        I bridge the gap between product vision and engineering execution. My opinion changes
        with new information.
      </p>
      <p class="mt-6 font-mono text-sm text-muted">Malm&ouml;, Sweden</p>
      <div class="mt-7 flex items-center gap-4">
        <a
          href="https://github.com/jgabor"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.05em] text-muted no-underline transition-colors hover:text-foreground"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/jgabor"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.05em] text-muted no-underline transition-colors hover:text-foreground"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
            <rect width="4" height="12" x="2" y="9" />
            <circle cx="4" cy="4" r="2" />
          </svg>
          LinkedIn
        </a>
        <a
          href="/CV-Jonathan_Gabor.pdf"
          class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.05em] text-muted no-underline transition-colors hover:text-foreground"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
            <path d="M14 2v4a2 2 0 0 0 2 2h4" />
            <path d="M12 18v-6" />
            <path d="m9 15 3 3 3-3" />
          </svg>
          CV
        </a>
      </div>
    </div>
    <div class="relative z-10 mt-10 md:mt-0">
      <div class="relative">
        <Image
          src={heroPhoto}
          alt="Jonathan Gabor"
          loading="eager"
          class="block h-80 w-[260px] object-cover object-top md:h-[420px] md:w-80"
        />
      </div>
    </div>
  </div>
</section>
