---
import { Picture } from "astro:assets";
import heroPhoto from "../assets/jgabor.jpg";
import HeroSchematic from "./HeroSchematic.astro";
import HeroBackdrop from "./HeroBackdrop.astro";
---

<section class="hero-section relative flex min-h-[100dvh] items-center overflow-hidden pt-20 pb-24 md:py-32">
  <HeroBackdrop />

  <div class="relative z-10 mx-auto w-full max-w-[1100px] px-6 md:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_minmax(320px,480px)] lg:gap-20">
      <div class="order-2 flex flex-col lg:order-1">
        <p class="mb-6 font-mono text-[0.625rem] uppercase tracking-[0.2em] text-muted">
          <span class="status-dot" aria-hidden="true"></span>
          Malmö, Sweden
        </p>

        <h1 class="font-display text-[clamp(3.5rem,12vw,8rem)] uppercase leading-[0.88] tracking-wide text-foreground">
          Jonathan<br />Gabor
        </h1>

        <h2 class="mt-6 font-mono text-sm uppercase tracking-[0.2em] text-foreground md:text-base">
          Speaks code, ships product.
        </h2>

        <p class="mt-5 max-w-md text-base leading-relaxed text-foreground md:text-lg">
          I bridge the gap between product vision and engineering execution. My opinion changes with new information.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-6">
          <a
            href="https://github.com/jgabor"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
          >
            GitHub
            <svg width="10" height="10" aria-hidden="true"><use href="#glyph-fork" /></svg>
          </a>
          <a
            href="https://linkedin.com/in/jgabor"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
          >
            LinkedIn
            <svg width="10" height="10" aria-hidden="true"><use href="#glyph-fork" /></svg>
          </a>
          <a href="/CV-Jonathan_Gabor.pdf" class="social-link">
            Download CV
            <svg width="10" height="10" aria-hidden="true"><use href="#glyph-fork" /></svg>
          </a>
        </div>
      </div>

      <div class="order-1 flex justify-center lg:order-2 lg:justify-end">
        <div class="hero-visual">
          <HeroSchematic />
          <div class="portrait-frame">
            <Picture
              src={heroPhoto}
              alt="Portrait photo of Jonathan Gabor"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[480, 960]}
              sizes="(min-width: 480px) 480px, 68vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="portrait-img"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="schematic-divider absolute bottom-8 left-6 right-6 mx-auto max-w-[1100px] md:left-8 md:right-8" aria-hidden="true">
    <hr class="dotted-rule" />
    <svg width="12" height="12"><use href="#glyph-plus" /></svg>
    <hr class="dotted-rule" />
  </div>
</section>
