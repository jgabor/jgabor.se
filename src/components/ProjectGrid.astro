---
import ProjectCard from "./ProjectCard.astro";
import SectionShell from "./SectionShell.astro";

interface Props {
  projects: Array<{
    id: string;
    title: string;
    type: string;
    description: string;
    tags: string[];
    url?: string;
  }>;
}

const { projects } = Astro.props;
---

<SectionShell
  id="projects"
  eyebrow="Projects"
  title="Things I've built"
  subtitle="Currently deep in agentic engineering."
  showConnector
>
  <div class="border-t border-black">
    {projects.map((project, i) => (
      <ProjectCard
        index={i + 1}
        title={project.title}
        type={project.type}
        description={project.description}
        tags={project.tags}
        url={project.url}
      />
    ))}
  </div>
</SectionShell>
