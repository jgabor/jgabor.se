---
import ProjectCard from "./ProjectCard.astro";

interface Props {
  projects: Array<{
    id: string;
    title: string;
    type: string;
    typeColor: string;
    description: string;
    tags: string[];
    url?: string;
  }>;
}

const { projects } = Astro.props;
---

<section class="relative py-24 md:py-36" id="projects">
  <div class="pointer-events-none absolute left-4 top-8 select-none font-mono text-[clamp(6rem,20vw,18rem)] font-bold leading-none opacity-[0.03] md:left-8">
    01
  </div>
  <div class="relative mx-auto mb-12 flex max-w-[1100px] items-end justify-between px-6 md:mb-16 md:px-8">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Projects</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-foreground md:text-4xl">Things I've built</h2>
      <p class="mt-3 max-w-md text-lg text-muted">Currently deeply into agentic engineering.</p>
    </div>
    <div class="hidden items-center gap-2 md:flex">
      <button
        id="scroll-left"
        disabled
        aria-label="Scroll left"
        class="flex items-center justify-center border border-overlay/12 bg-transparent p-2 text-muted transition-all hover:border-overlay/30 hover:text-foreground disabled:cursor-default disabled:opacity-20 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>
      <button
        id="scroll-right"
        aria-label="Scroll right"
        class="flex items-center justify-center border border-overlay/12 bg-transparent p-2 text-muted transition-all hover:border-overlay/30 hover:text-foreground disabled:cursor-default disabled:opacity-20 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>
    </div>
  </div>
  <div
    class="flex gap-4 overflow-x-auto px-6 pb-4 snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:gap-5 md:px-8"
    id="scroll-strip"
  >
    <div class="w-0 flex-shrink-0 md:w-[calc((100vw-1100px)/2)]"></div>
    {projects.map((project) => (
      <ProjectCard
        title={project.title}
        type={project.type}
        typeColor={project.typeColor}
        description={project.description}
        tags={project.tags}
        url={project.url}
      />
    ))}
    <div class="w-6 flex-shrink-0 md:w-[calc((100vw-1100px)/2)]"></div>
  </div>
  <p class="mt-4 text-center font-mono text-xs text-muted/50 md:hidden">Swipe to see more &rarr;</p>
</section>

<script>
  const strip = document.getElementById("scroll-strip");
  const leftBtn = document.getElementById("scroll-left") as HTMLButtonElement | null;
  const rightBtn = document.getElementById("scroll-right") as HTMLButtonElement | null;

  function updateScrollButtons() {
    if (!strip || !leftBtn || !rightBtn) return;
    leftBtn.disabled = strip.scrollLeft <= 10;
    rightBtn.disabled = strip.scrollLeft >= strip.scrollWidth - strip.clientWidth - 10;
  }

  if (strip) {
    strip.addEventListener("scroll", updateScrollButtons, { passive: true });
    updateScrollButtons();
  }

  leftBtn?.addEventListener("click", () => {
    strip?.scrollBy({ left: -340, behavior: "smooth" });
  });

  rightBtn?.addEventListener("click", () => {
    strip?.scrollBy({ left: 340, behavior: "smooth" });
  });
</script>
