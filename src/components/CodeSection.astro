---
import CodeCard from "./CodeCard.astro";
import SectionShell from "./SectionShell.astro";
import { homeCopy } from "../data/home-copy";

interface Props {
  entries: Array<{
    id: string;
    title: string;
    type: string;
    description: string;
    tags: string[];
    url?: string;
  }>;
}

const { entries } = Astro.props;
---

<SectionShell
  id="code"
  eyebrow={homeCopy.code.eyebrow}
  title={homeCopy.code.title}
  subtitle={homeCopy.code.subtitle}
  showConnector
>
  <div class="code-list border-t border-foreground">
    {entries.map((entry, i) => (
      <CodeCard
        index={i + 1}
        title={entry.title}
        type={entry.type}
        description={entry.description}
        tags={entry.tags}
        url={entry.url}
      />
    ))}
  </div>
</SectionShell>
