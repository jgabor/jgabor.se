---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  showConnector?: boolean;
}

const { id, eyebrow, title, subtitle, showConnector = false } = Astro.props;
---

<section class="relative py-24 md:py-36" id={id}>
  <div class="relative mx-auto max-w-[1100px] px-6 md:px-8">
    <div class="relative mb-12 md:mb-16">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="mt-4 font-display text-3xl uppercase tracking-wide text-foreground md:text-5xl">{title}</h2>
      {subtitle && (
        <p class="mt-3 max-w-lg text-lg text-muted">{subtitle}</p>
      )}
    </div>
    <div class="relative">
      <slot />
    </div>
    {showConnector && (
      <div class="schematic-divider mt-16" aria-hidden="true">
        <hr class="dotted-rule flex-1" />
        <svg width="12" height="12" aria-hidden="true"><use href="#glyph-spine" /></svg>
        <hr class="dotted-rule flex-1" />
      </div>
    )}
  </div>
</section>
