---
import ContactSchematic from "./ContactSchematic.astro";
import SectionShell from "./SectionShell.astro";

const channels = [
  { label: "GitHub", href: "https://github.com/jgabor", external: true },
  { label: "LinkedIn", href: "https://linkedin.com/in/jgabor", external: true },
  { label: "Download CV", href: "/CV-Jonathan_Gabor.pdf", external: false },
];
---

<SectionShell
  id="contact"
  eyebrow="Contact"
  title="Get in touch"
  subtitle="Have a product challenge, role, or collaboration in mind?"
>
  <div class="contact-layout">
    <div class="contact-main fade-in">
      <form class="contact-form" id="contact-form">
        <div class="contact-field-group">
          <label
            for="contact-email"
            class="contact-label"
          >
            Email
          </label>
          <input
            type="email"
            id="contact-email"
            name="from"
            required
            placeholder="you@company.com"
            class="contact-field"
          />
        </div>

        <div class="contact-field-group">
          <label
            for="contact-message"
            class="contact-label"
          >
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            required
            placeholder="What's on your mind?"
            class="contact-field contact-field-area"
          ></textarea>
        </div>

        <button type="submit" id="contact-submit" class="contact-submit">
          SEND MESSAGE
        </button>

        <p class="contact-form-note">
          <span class="status-dot" aria-hidden="true"></span>
          Usually replies within a few days
        </p>
      </form>

      <div class="contact-meta">
        <div class="contact-links">
          {channels.map((channel) => (
            <a
              href={channel.href}
              class="social-link"
              {...(channel.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {channel.label}
              <svg width="10" height="10" aria-hidden="true"><use href="#glyph-fork" /></svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="contact-schematic-wrap fade-in" aria-hidden="true">
      <ContactSchematic />
    </div>
  </div>
</SectionShell>

<script>
  const contactForm = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;

  contactForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";

    const emailInput = document.getElementById("contact-email") as HTMLInputElement;
    const messageInput = document.getElementById("contact-message") as HTMLTextAreaElement;

    fetch("/api/contact", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        from: emailInput.value,
        message: messageInput.value,
      }),
    })
      .then((res) => {
        if (!res.ok) throw new Error("Failed");
        submitBtn.textContent = "Sent!";
        contactForm.reset();
        setTimeout(() => {
          submitBtn.textContent = "SEND MESSAGE";
          submitBtn.disabled = false;
        }, 3000);
      })
      .catch(() => {
        submitBtn.textContent = "Failed — try again";
        setTimeout(() => {
          submitBtn.textContent = "SEND MESSAGE";
          submitBtn.disabled = false;
        }, 3000);
      });
  });
</script>
