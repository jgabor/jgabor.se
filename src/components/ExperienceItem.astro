---
interface Props {
  company: string;
  tenure?: string;
  roles: Array<{
    title: string;
    period: string;
    location?: string;
    description: string[];
  }>;
}

const { company, tenure, roles } = Astro.props;
---

<div class="fade-in">
  <div class="mb-6 flex items-baseline gap-4">
    <h3 class="text-2xl font-bold text-white">{company}</h3>
    {tenure && (
      <span class="font-mono text-xs uppercase tracking-[0.05em] text-gray-500">{tenure}</span>
    )}
  </div>
  <div class="flex flex-col gap-8 border-l border-white/[0.12] pl-6 md:pl-10">
    {roles.map((role) => (
      <div class="grid gap-2 md:grid-cols-[200px_1fr]">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.05em] text-gray-500">{role.period}</p>
          {role.location && (
            <p class="font-mono text-xs text-gray-500/60">{role.location}</p>
          )}
        </div>
        <div>
          <h4 class="text-base font-semibold text-white">{role.title}</h4>
          {role.description.map((p) => (
            <p class="mt-2 text-base leading-relaxed text-gray-500">{p}</p>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
