---
const navLinks = [
  { href: "#code", label: "Code" },
  { href: "#career", label: "Career" },
  { href: "#contact", label: "Contact" },
];
---

<header class="nav-header">
  <nav class="nav-inner" aria-label="Primary">
    <a href="#" class="nav-logo">JG</a>

    <div class="nav-links">
      <div class="nav-link-list">
        {navLinks.map((link) => (
          <a href={link.href} class="nav-link">{link.label}</a>
        ))}
      </div>
      <div class="nav-junction" aria-hidden="true">
        <svg width="10" height="10"><use href="#glyph-plus" /></svg>
      </div>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="nav-theme-btn"
      >
        <span class="nav-theme-marks" aria-hidden="true"></span>
        <svg id="theme-icon-sun" aria-hidden="true" class="hidden" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 16 16" fill="currentColor">
          <rect x="5" y="5" width="6" height="6" />
          <rect x="7" y="1" width="2" height="2" />
          <rect x="7" y="13" width="2" height="2" />
          <rect x="1" y="7" width="2" height="2" />
          <rect x="13" y="7" width="2" height="2" />
          <rect x="3" y="3" width="2" height="2" />
          <rect x="11" y="3" width="2" height="2" />
          <rect x="3" y="11" width="2" height="2" />
          <rect x="11" y="11" width="2" height="2" />
        </svg>
        <svg id="theme-icon-moon" aria-hidden="true" class="hidden" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 16 16" fill="currentColor">
          <path d="M11 1 H6 V3 H4 V5 H3 V11 H4 V13 H6 V15 H11 V13 H8 V11 H6 V5 H8 V3 H11 Z" />
        </svg>
      </button>
    </div>

    <div class="nav-mobile-actions">
      <button
        id="theme-toggle-mobile"
        type="button"
        aria-label="Toggle theme"
        class="nav-theme-btn"
      >
        <span class="nav-theme-marks" aria-hidden="true"></span>
        <svg id="theme-icon-sun-mobile" aria-hidden="true" class="hidden" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 16 16" fill="currentColor">
          <rect x="5" y="5" width="6" height="6" />
          <rect x="7" y="1" width="2" height="2" />
          <rect x="7" y="13" width="2" height="2" />
          <rect x="1" y="7" width="2" height="2" />
          <rect x="13" y="7" width="2" height="2" />
          <rect x="3" y="3" width="2" height="2" />
          <rect x="11" y="3" width="2" height="2" />
          <rect x="3" y="11" width="2" height="2" />
          <rect x="11" y="11" width="2" height="2" />
        </svg>
        <svg id="theme-icon-moon-mobile" aria-hidden="true" class="hidden" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 16 16" fill="currentColor">
          <path d="M11 1 H6 V3 H4 V5 H3 V11 H4 V13 H6 V15 H11 V13 H8 V11 H6 V5 H8 V3 H11 Z" />
        </svg>
      </button>
      <button
        id="nav-menu-toggle"
        type="button"
        class="nav-hamburger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-mobile-panel"
      >
        <span class="nav-hamburger-line"></span>
        <span class="nav-hamburger-line"></span>
        <span class="nav-hamburger-line"></span>
      </button>
    </div>
  </nav>

  <div id="nav-mobile-panel" class="nav-mobile-panel" aria-hidden="true">
    <div class="nav-mobile-links">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-mobile-link">{link.label}</a>
      ))}
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById("nav-menu-toggle");
  const mobilePanel = document.getElementById("nav-mobile-panel");
  const mobileLinks = mobilePanel?.querySelectorAll(".nav-mobile-link");
  const themeToggles = [
    document.getElementById("theme-toggle"),
    document.getElementById("theme-toggle-mobile"),
  ];
  const sunIcons = [
    document.getElementById("theme-icon-sun"),
    document.getElementById("theme-icon-sun-mobile"),
  ];
  const moonIcons = [
    document.getElementById("theme-icon-moon"),
    document.getElementById("theme-icon-moon-mobile"),
  ];

  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains("dark");
    sunIcons.forEach((icon) => icon?.classList.toggle("hidden", !isDark));
    moonIcons.forEach((icon) => icon?.classList.toggle("hidden", isDark));
  }

  function setMenuOpen(open: boolean) {
    if (!menuToggle || !mobilePanel) return;

    menuToggle.setAttribute("aria-expanded", open ? "true" : "false");
    menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menuToggle.classList.toggle("is-open", open);
    mobilePanel.classList.toggle("is-open", open);
    mobilePanel.setAttribute("aria-hidden", open ? "false" : "true");
    document.body.style.overflow = open ? "hidden" : "";
  }

  updateThemeIcons();

  themeToggles.forEach((toggle) => {
    toggle?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      updateThemeIcons();
    });
  });

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    setMenuOpen(!isOpen);
  });

  mobileLinks?.forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuToggle?.getAttribute("aria-expanded") === "true") {
      setMenuOpen(false);
      menuToggle.focus();
    }
  });

  // Scroll-spy: highlight the nav link for the section in the reading band.
  const sectionLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".nav-link[href^='#']"),
  );
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const link = sectionLinks.find(
          (l) => l.getAttribute("href") === `#${entry.target.id}`,
        );
        link?.classList.toggle("is-active", entry.isIntersecting);
      });
    },
    { rootMargin: "-35% 0px -55% 0px" },
  );

  sectionLinks.forEach((link) => {
    const section = document.querySelector(link.getAttribute("href") ?? "");
    if (section) spy.observe(section);
  });
</script>
