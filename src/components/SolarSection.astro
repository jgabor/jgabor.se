---
---

<div class="solar-stage">
<div class="solar-rift" aria-hidden="true">
  <svg
    class="solar-rift-svg"
    viewBox="0 0 1440 124"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <filter id="rift-glow" x="-20%" y="-50%" width="140%" height="200%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="8" />
      </filter>
    </defs>
    <path
      id="rift-fill-path"
      d="M0,68 C60,72 95,58 155,63 C218,68 268,52 338,61 C405,70 462,48 528,58 C598,69 655,44 722,56 C788,67 848,50 918,62 C985,73 1048,46 1118,59 C1185,71 1255,53 1320,64 C1385,74 1418,58 1440,62 L1440,124 L0,124 Z"
      class="solar-rift-fill"
    />
    <path
      id="rift-glow-path"
      d="M0,68 C60,72 95,58 155,63 C218,68 268,52 338,61 C405,70 462,48 528,58 C598,69 655,44 722,56 C788,67 848,50 918,62 C985,73 1048,46 1118,59 C1185,71 1255,53 1320,64 C1385,74 1418,58 1440,62"
      class="solar-rift-edge-glow"
    />
    <path
      id="rift-edge-path"
      d="M0,68 C60,72 95,58 155,63 C218,68 268,52 338,61 C405,70 462,48 528,58 C598,69 655,44 722,56 C788,67 848,50 918,62 C985,73 1048,46 1118,59 C1185,71 1255,53 1320,64 C1385,74 1418,58 1440,62"
      class="solar-rift-edge"
    />
  </svg>
</div>

<div
  id="solar-section"
  class="solar-section"
>
  <canvas
    id="solar-canvas"
    class="absolute inset-0 h-full w-full"
    aria-hidden="true"
  ></canvas>

  <div class="relative z-10 flex h-full min-h-[inherit] flex-col items-center justify-end px-6 pb-32 md:pb-48">
    <div class="footer-reveal text-center">
      <p class="solar-headline font-mono uppercase tracking-[0.12em] text-white">
        <span class="whitespace-nowrap">Let's explore</span>
        <span class="whitespace-nowrap">something together</span>
      </p>
    </div>
  </div>
</div>
</div>

<style>
  .solar-stage {
    display: flex;
    flex-direction: column;
    line-height: 0;
  }

  .solar-rift {
    position: relative;
    z-index: 2;
    overflow: hidden;
    background: var(--ef-white);
  }

  .solar-rift-svg {
    display: block;
    width: 100%;
    height: clamp(60px, 8vw, 120px);
    margin-bottom: -4px;
    color: var(--ef-gray);
  }

  .solar-rift-fill {
    fill: var(--ef-cosmos);
  }

  .solar-rift-edge-glow {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    filter: url(#rift-glow);
    opacity: 0.35;
  }

  .solar-rift-edge {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.75;
    opacity: 0.85;
  }

  .solar-section {
    position: relative;
    z-index: 1;
    overflow: hidden;
    min-height: clamp(500px, 70vh, 900px);
    margin-top: -4px;
    background: var(--ef-cosmos);
  }

  .solar-headline {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15em;
    font-size: clamp(1.25rem, 4.5vw, 3rem);
    line-height: 1.1;
  }

</style>

<script>
  const canvas = document.getElementById("solar-canvas") as HTMLCanvasElement;
  const section = document.getElementById("solar-section") as HTMLElement;
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && section) {
    const ctx = canvas.getContext("2d")!;
    let width = 0;
    let height = 0;
    let mouseX = 0;
    let mouseY = 0;
    let scrollOffset = 0;
    let animationId: number;
    let isVisible = false;
    let frozenTime = 0;

    const STAR_COLORS = [
      [255, 245, 235],
      [255, 230, 200],
      [255, 200, 150],
      [255, 160, 120],
      [200, 220, 255],
      [170, 200, 255],
      [220, 240, 255],
    ];

    const STAR_COUNT = 400;
    const stars: {
      x: number;
      y: number;
      z: number;
      brightness: number;
      color: number[];
      twinkleSpeed: number;
    }[] = [];

    const PLANETS = [
      { orbitMul: 1.6, speed: 4.15, radius: 2, hue: 35, sat: 30, lit: 55, hasRing: false, moons: 0 },
      { orbitMul: 2.2, speed: 1.62, radius: 3.5, hue: 40, sat: 50, lit: 65, hasRing: false, moons: 0 },
      { orbitMul: 3.0, speed: 1.0, radius: 3.8, hue: 210, sat: 65, lit: 50, hasRing: false, moons: 1 },
      { orbitMul: 3.8, speed: 0.53, radius: 2.8, hue: 15, sat: 70, lit: 45, hasRing: false, moons: 0 },
      { orbitMul: 5.5, speed: 0.084, radius: 8, hue: 30, sat: 55, lit: 55, hasRing: false, moons: 2 },
      { orbitMul: 7.2, speed: 0.034, radius: 7, hue: 42, sat: 60, lit: 62, hasRing: true, moons: 1 },
      { orbitMul: 9.0, speed: 0.012, radius: 5, hue: 185, sat: 50, lit: 60, hasRing: false, moons: 0 },
      { orbitMul: 11.0, speed: 0.006, radius: 4.8, hue: 225, sat: 60, lit: 50, hasRing: false, moons: 0 },
    ];

    const planetAngles = PLANETS.map(() => Math.random() * Math.PI * 2);

    function initStars() {
      stars.length = 0;
      for (let i = 0; i < STAR_COUNT; i++) {
        stars.push({
          x: Math.random() * 2 - 1,
          y: Math.random() * 2 - 1,
          z: Math.random() * 0.8 + 0.2,
          brightness: Math.random() * 0.7 + 0.2,
          color: STAR_COLORS[Math.floor(Math.random() * STAR_COLORS.length)],
          twinkleSpeed: 0.001 + Math.random() * 0.004,
        });
      }
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function updateMouse(e: MouseEvent) {
      if (prefersReducedMotion) return;
      const rect = section.getBoundingClientRect();
      mouseX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouseY = ((e.clientY - rect.top) / rect.height) * 2 - 1;
    }

    function updateScroll() {
      if (prefersReducedMotion) return;
      const rect = section.getBoundingClientRect();
      const viewH = window.innerHeight;
      scrollOffset = 1 - (rect.top + rect.height) / (viewH + rect.height);
      scrollOffset = Math.max(0, Math.min(1, scrollOffset));
    }

    function drawPlanet(
      x: number,
      y: number,
      r: number,
      hue: number,
      sat: number,
      lit: number,
      sunX: number,
      sunY: number,
      hasRing: boolean,
      moons: number,
      time: number,
    ) {
      const angleToSun = Math.atan2(sunY - y, sunX - x);
      const lightOffX = Math.cos(angleToSun) * r * 0.35;
      const lightOffY = Math.sin(angleToSun) * r * 0.35;

      const pGrad = ctx.createRadialGradient(x + lightOffX, y + lightOffY, 0, x, y, r);
      pGrad.addColorStop(0, `hsla(${hue}, ${sat}%, ${lit + 18}%, 1)`);
      pGrad.addColorStop(0.6, `hsla(${hue}, ${sat}%, ${lit}%, 1)`);
      pGrad.addColorStop(1, `hsla(${hue}, ${sat - 10}%, ${lit - 20}%, 1)`);

      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.fillStyle = pGrad;
      ctx.fill();

      const atmo = ctx.createRadialGradient(x, y, r * 0.9, x, y, r * 1.8);
      atmo.addColorStop(0, `hsla(${hue}, ${sat}%, ${lit + 10}%, 0)`);
      atmo.addColorStop(0.6, `hsla(${hue}, ${sat}%, ${lit + 10}%, 0.06)`);
      atmo.addColorStop(1, `hsla(${hue}, ${sat}%, ${lit}%, 0)`);
      ctx.beginPath();
      ctx.arc(x, y, r * 1.8, 0, Math.PI * 2);
      ctx.fillStyle = atmo;
      ctx.fill();

      if (hasRing) {
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(-0.4);
        ctx.scale(1, 0.3);

        for (let ri = 0; ri < 3; ri++) {
          const ringR = r * (1.6 + ri * 0.35);
          const ringAlpha = 0.35 - ri * 0.08;
          ctx.beginPath();
          ctx.arc(0, 0, ringR, 0, Math.PI * 2);
          ctx.strokeStyle = `hsla(${hue + 10}, ${sat - 15}%, ${lit + 10}%, ${ringAlpha})`;
          ctx.lineWidth = r * 0.3 - ri * 0.5;
          ctx.stroke();
        }
        ctx.restore();
      }

      for (let m = 0; m < moons; m++) {
        const moonAngle = time * 0.002 * (m + 1) + m * 2.1;
        const moonDist = r * (2.2 + m * 1.2);
        const mx = x + Math.cos(moonAngle) * moonDist;
        const my = y + Math.sin(moonAngle) * moonDist * 0.5;
        const moonR = Math.max(1, r * 0.18);

        ctx.beginPath();
        ctx.arc(mx, my, moonR, 0, Math.PI * 2);
        ctx.fillStyle = "hsla(0, 0%, 75%, 0.8)";
        ctx.fill();
      }
    }

    function draw(time: number) {
      if (!isVisible) return;

      ctx.clearRect(0, 0, width, height);

      const cx = width / 2 + mouseX * 40;
      const cy = height * 0.42 + mouseY * 30 + (scrollOffset - 0.5) * 60;

      const sunRadius = Math.min(width, height) * 0.06;
      const orbitUnit = Math.min(width, height) * 0.035;

      const outerGlow = ctx.createRadialGradient(cx, cy, 0, cx, cy, sunRadius * 12);
      outerGlow.addColorStop(0, "hsla(40, 100%, 70%, 0.12)");
      outerGlow.addColorStop(0.15, "hsla(35, 95%, 60%, 0.08)");
      outerGlow.addColorStop(0.3, "hsla(25, 90%, 55%, 0.04)");
      outerGlow.addColorStop(0.5, "hsla(15, 80%, 50%, 0.02)");
      outerGlow.addColorStop(1, "hsla(15, 80%, 50%, 0)");
      ctx.fillStyle = outerGlow;
      ctx.fillRect(0, 0, width, height);

      for (const star of stars) {
        const parallaxStrength = star.z * 0.6;
        const sx = star.x * width * 0.6 + cx + mouseX * parallaxStrength * 80;
        const sy =
          star.y * height * 0.6 +
          cy +
          mouseY * parallaxStrength * 60 +
          (scrollOffset - 0.5) * parallaxStrength * 100;

        const twinkle = prefersReducedMotion
          ? star.brightness
          : 0.4 + 0.6 * Math.sin(time * star.twinkleSpeed + star.x * 100 + star.y * 100);
        const alpha = star.brightness * twinkle;
        const size = star.z * 1.8;
        const [r, g, b] = star.color;

        if (size > 1.2 && alpha > 0.45) {
          ctx.beginPath();
          ctx.arc(sx, sy, size * 3, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha * 0.1})`;
          ctx.fill();
        }

        ctx.beginPath();
        ctx.arc(sx, sy, size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
        ctx.fill();
      }

      const TILT = 0.3;
      for (const p of PLANETS) {
        const orbitRadius = orbitUnit * p.orbitMul;
        ctx.save();
        ctx.translate(cx, cy);
        ctx.scale(1, TILT);
        ctx.beginPath();
        ctx.arc(0, 0, orbitRadius, 0, Math.PI * 2);
        ctx.strokeStyle = "hsla(0, 0%, 100%, 0.04)";
        ctx.lineWidth = 0.5;
        ctx.stroke();
        ctx.restore();
      }

      interface PlanetDraw {
        x: number;
        y: number;
        z: number;
        idx: number;
      }
      const planetPositions: PlanetDraw[] = [];

      const t = time * 0.0001;
      for (let i = 0; i < PLANETS.length; i++) {
        const p = PLANETS[i];
        const angle = planetAngles[i] + t * p.speed;
        const orbitRadius = orbitUnit * p.orbitMul;
        const px = cx + Math.cos(angle) * orbitRadius;
        const py = cy + Math.sin(angle) * orbitRadius * TILT;

        planetPositions.push({ x: px, y: py, z: Math.sin(angle), idx: i });
      }

      planetPositions.sort((a, b) => a.z - b.z);

      for (const pp of planetPositions) {
        if (pp.z >= 0) continue;
        const p = PLANETS[pp.idx];
        drawPlanet(pp.x, pp.y, p.radius, p.hue, p.sat, p.lit, cx, cy, p.hasRing, p.moons, time);
      }

      const corona = ctx.createRadialGradient(cx, cy, sunRadius * 0.5, cx, cy, sunRadius * 3.5);
      corona.addColorStop(0, "hsla(45, 100%, 75%, 0.3)");
      corona.addColorStop(0.3, "hsla(40, 100%, 65%, 0.12)");
      corona.addColorStop(0.6, "hsla(30, 95%, 55%, 0.04)");
      corona.addColorStop(1, "hsla(20, 90%, 50%, 0)");
      ctx.beginPath();
      ctx.arc(cx, cy, sunRadius * 3.5, 0, Math.PI * 2);
      ctx.fillStyle = corona;
      ctx.fill();

      const sunGrad = ctx.createRadialGradient(cx - sunRadius * 0.2, cy - sunRadius * 0.2, 0, cx, cy, sunRadius);
      sunGrad.addColorStop(0, "hsla(50, 100%, 95%, 1)");
      sunGrad.addColorStop(0.3, "hsla(45, 100%, 80%, 1)");
      sunGrad.addColorStop(0.7, "hsla(38, 100%, 65%, 1)");
      sunGrad.addColorStop(1, "hsla(25, 95%, 55%, 1)");
      ctx.beginPath();
      ctx.arc(cx, cy, sunRadius, 0, Math.PI * 2);
      ctx.fillStyle = sunGrad;
      ctx.fill();

      const shimmerAlpha = prefersReducedMotion ? 0.15 : 0.15 + 0.05 * Math.sin(time * 0.005);
      const shimmer = ctx.createRadialGradient(cx + sunRadius * 0.15, cy + sunRadius * 0.1, 0, cx, cy, sunRadius);
      shimmer.addColorStop(0, `hsla(55, 100%, 90%, ${shimmerAlpha})`);
      shimmer.addColorStop(1, "hsla(55, 100%, 90%, 0)");
      ctx.beginPath();
      ctx.arc(cx, cy, sunRadius, 0, Math.PI * 2);
      ctx.fillStyle = shimmer;
      ctx.fill();

      for (const pp of planetPositions) {
        if (pp.z < 0) continue;
        const p = PLANETS[pp.idx];
        drawPlanet(pp.x, pp.y, p.radius, p.hue, p.sat, p.lit, cx, cy, p.hasRing, p.moons, time);
      }

      if (!prefersReducedMotion) {
        animationId = requestAnimationFrame(draw);
      }
    }

    const visObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !isVisible) {
          isVisible = true;
          resize();
          if (prefersReducedMotion) {
            draw(frozenTime);
          } else {
            animationId = requestAnimationFrame(draw);
          }
        } else if (!entry.isIntersecting && isVisible) {
          isVisible = false;
          cancelAnimationFrame(animationId);
        }
      },
      { threshold: 0.05 },
    );

    initStars();
    resize();
    visObserver.observe(section);

    window.addEventListener("resize", () => {
      resize();
      initStars();
      if (isVisible && prefersReducedMotion) {
        draw(frozenTime);
      }
    });
    window.addEventListener("mousemove", updateMouse, { passive: true });
    window.addEventListener("scroll", updateScroll, { passive: true });
  }

  const DECODE_GLYPHS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+/<>[]#=";

  function decodeHeadline(root: Element) {
    const spans = root.querySelectorAll<HTMLElement>(".solar-headline span");
    spans.forEach((span, lineIndex) => {
      const original = span.textContent ?? "";
      const duration = 2800;

      window.setTimeout(() => {
        const start = performance.now();
        const tick = (now: number) => {
          const progress = Math.min(1, (now - start) / duration);
          const locked = Math.floor(progress * original.length);
          let out = "";
          for (let i = 0; i < original.length; i++) {
            const ch = original[i];
            out =
              out +
              (i < locked || ch === " " || ch === "'"
                ? ch
                : DECODE_GLYPHS[Math.floor(Math.random() * DECODE_GLYPHS.length)]);
          }
          span.textContent = out;
          if (progress < 1) {
            requestAnimationFrame(tick);
          } else {
            span.textContent = original;
          }
        };
        requestAnimationFrame(tick);
      }, lineIndex * 700);
    });
  }

  const footerObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          if (!prefersReducedMotion) decodeHeadline(entry.target);
          footerObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 },
  );

  document.querySelectorAll(".footer-reveal").forEach((el, i) => {
    (el as HTMLElement).style.transitionDelay = `${i * 200}ms`;
    footerObserver.observe(el);
  });

  const riftFill = document.getElementById("rift-fill-path");
  const riftGlow = document.getElementById("rift-glow-path");
  const riftEdge = document.getElementById("rift-edge-path");
  const riftRoot = document.querySelector(".solar-rift");

  if (riftFill && riftGlow && riftEdge && riftRoot && !prefersReducedMotion) {
    const RIFT_W = 1440;
    const RIFT_H = 124;
    const RIFT_BASE = 64;
    const STEPS = 56;
    let riftAnimId = 0;
    let riftVisible = false;

    function riftSeeds(count: number, seed: number): number[] {
      const out: number[] = [];
      let s = seed;
      for (let i = 0; i < count; i++) {
        s = (s * 16807) % 2147483647;
        out.push(s / 2147483647);
      }
      return out;
    }

    const riftCoarse = riftSeeds(24, 48271);
    const riftFine = riftSeeds(48, 91357);

    function riftLerp(seeds: number[], nx: number): number {
      const idx = nx * (seeds.length - 1);
      const i = Math.floor(idx);
      const f = idx - i;
      const a = seeds[i] ?? 0;
      const b = seeds[i + 1] ?? a;
      return a + (b - a) * f;
    }

    function riftWaveY(x: number, t: number): number {
      const nx = x / RIFT_W;
      const tt = t * 0.00048;
      const pulse = 0.55 + 0.45 * Math.sin(tt * 1.7 + riftLerp(riftCoarse, nx) * 1.2);

      const coarse = (riftLerp(riftCoarse, nx) - 0.5) * 2;
      const fine = (riftLerp(riftFine, nx * 2.7 + 0.13) - 0.5) * 2;
      const amp = 0.72 + 0.28 * riftLerp(riftCoarse, nx * 1.9 + 0.31);

      let y = RIFT_BASE;
      y += coarse * 9 * amp;
      y += fine * 4.5;
      y += Math.sin(nx * Math.PI * 3.71 + tt * 1.13) * 10 * pulse * amp;
      y += Math.sin(nx * Math.PI * 8.37 + tt * 2.67) * 5.5 * (0.85 + 0.15 * fine);
      y += Math.sin(nx * Math.PI * 17.93 + tt * 5.41) * 2.8;
      y += Math.sin(nx * Math.PI * 23.17 + tt * 7.83) * 1.6;
      y += Math.sin(nx * Math.PI * 11.29 + tt * 4.07) * 3.2 * pulse;

      const spark =
        Math.sin(nx * 37.7 + tt * 3.9) * Math.sin(nx * 53.3 - tt * 2.1 + riftLerp(riftFine, nx) * 2);
      if (spark > 0.58) {
        y -= (spark - 0.58) * (38 + 22 * riftLerp(riftFine, nx * 3.1));
      }

      return y;
    }

    function riftSmoothPath(points: Array<{ x: number; y: number }>): string {
      if (points.length < 2) return "";
      const tension = 6.25;
      let d = `M${points[0].x.toFixed(1)},${points[0].y.toFixed(1)}`;

      for (let i = 0; i < points.length - 1; i++) {
        const p0 = points[i - 1] ?? points[i];
        const p1 = points[i];
        const p2 = points[i + 1];
        const p3 = points[i + 2] ?? p2;

        const cp1x = p1.x + (p2.x - p0.x) / tension;
        const cp1y = p1.y + (p2.y - p0.y) / tension;
        const cp2x = p2.x - (p3.x - p1.x) / tension;
        const cp2y = p2.y - (p3.y - p1.y) / tension;

        d += ` C${cp1x.toFixed(1)},${cp1y.toFixed(1)} ${cp2x.toFixed(1)},${cp2y.toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
      }

      return d;
    }

    function riftStrokePath(t: number): string {
      const dx = RIFT_W / STEPS;
      const points: Array<{ x: number; y: number }> = [];
      for (let i = 0; i <= STEPS; i++) {
        points.push({ x: i * dx, y: riftWaveY(i * dx, t) });
      }
      return riftSmoothPath(points);
    }

    function drawRift(t: number) {
      if (!riftVisible) return;
      const stroke = riftStrokePath(t);
      riftGlow.setAttribute("d", stroke);
      riftEdge.setAttribute("d", stroke);
      riftFill.setAttribute("d", `${stroke} L${RIFT_W},${RIFT_H} L0,${RIFT_H} Z`);
      riftAnimId = requestAnimationFrame(drawRift);
    }

    const riftObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !riftVisible) {
          riftVisible = true;
          riftAnimId = requestAnimationFrame(drawRift);
        } else if (!entry.isIntersecting && riftVisible) {
          riftVisible = false;
          cancelAnimationFrame(riftAnimId);
        }
      },
      { threshold: 0 },
    );

    riftObserver.observe(riftRoot);
  }
</script>
