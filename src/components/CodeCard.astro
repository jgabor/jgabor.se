---
interface Props {
  index: number;
  title: string;
  type: string;
  description: string;
  tags: string[];
  url?: string;
}

const { index, title, type, description, tags, url } = Astro.props;
const number = String(index).padStart(2, "0");

const Tag = url ? "a" : "div";
const tagProps = url
  ? { href: url, target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<Tag class="code-row group" {...tagProps}>
  <div class="code-marker">
    <div class="code-number">{number}</div>
    <svg width="12" height="16" class="text-foreground" aria-hidden="true">
      <use href="#glyph-pylon" />
    </svg>
  </div>

  <div>
    <h3 class="font-display text-xl uppercase tracking-wide text-foreground md:text-2xl">
      {title}
    </h3>
    <span class="type-tag mt-2 inline-block">{type}</span>
  </div>

  <div>
    <p class="text-base leading-relaxed text-foreground">{description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="chip">{tag}</span>
      ))}
    </div>
  </div>
</Tag>
