---
import CareerChart from "./CareerChart.astro";
import { scaleBarHeights } from "../utils/career-tenure";

interface Props {
  entries: Array<{
    company: string;
    tenure?: string;
    location?: string;
    roles: Array<{
      title: string;
      period: string;
      location?: string;
      description: string[];
    }>;
  }>;
}

const { entries } = Astro.props;

const chronological = [...entries].reverse();
const barHeights = scaleBarHeights(
  chronological.map((entry) => entry.tenure ?? ""),
  40,
  140,
);
---

<div class="fade-in">
  <div class="mb-16 hidden lg:block">
    <CareerChart entries={chronological} />
  </div>

  <div class="mb-16 flex flex-col gap-8 lg:hidden">
    {chronological.map((entry, i) => (
      <div class="flex gap-4">
        <div class="flex flex-col items-center">
          <div class="career-index schematic-border shrink-0">
            {String(i + 1).padStart(2, "0")}
          </div>
          <div
            class="career-bar w-3"
            style={`height: ${barHeights[i]}px`}
          ></div>
        </div>
        <div class="min-w-0 flex-1 border-t border-foreground pt-3">
          <h3 class="font-display text-lg uppercase tracking-wide">{entry.company}</h3>
          {entry.tenure && (
            <span class="type-tag mt-2 inline-block">{entry.tenure}</span>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="flex flex-col gap-16">
    {entries.map((entry) => (
      <div>
        <div class="career-company-header">
          <h3 class="font-display text-2xl uppercase leading-none tracking-wide">{entry.company}</h3>
          {entry.tenure && (
            <span class="type-tag">{entry.tenure}</span>
          )}
        </div>
        <div class="flex flex-col gap-8 border-l border-foreground pl-6 md:pl-10">
          {entry.roles.map((role) => (
            <div class="grid gap-2 md:grid-cols-[minmax(220px,auto)_1fr]">
              <div class="min-w-0">
                <p class="font-mono text-xs uppercase tracking-[0.15em] text-foreground">{role.period}</p>
                {(role.location ?? entry.location) && (
                  <p class="mt-1 font-mono text-xs uppercase tracking-[0.15em] text-muted">
                    {role.location ?? entry.location}
                  </p>
                )}
              </div>
              <div>
                <h4 class="text-base font-semibold">{role.title}</h4>
                {role.description.map((p) => (
                  <p class="mt-2 text-base leading-relaxed text-foreground">{p}</p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
