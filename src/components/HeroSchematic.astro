---
---

<svg
  class="hero-schematic-svg"
  viewBox="0 0 360 480"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <pattern id="hero-hatch-h" patternUnits="userSpaceOnUse" width="8" height="6">
      <line x1="0" y1="3" x2="8" y2="3" stroke="currentColor" stroke-width="0.75" />
    </pattern>
    <pattern id="hero-hatch-d" patternUnits="userSpaceOnUse" width="8" height="8">
      <path d="M-1,1 l2,-2 M0,8 l8,-8 M7,9 l2,-2" stroke="currentColor" stroke-width="0.75" fill="none" />
    </pattern>
    <pattern id="hero-hatch-v" patternUnits="userSpaceOnUse" width="6" height="8">
      <line x1="3" y1="0" x2="3" y2="8" stroke="currentColor" stroke-width="0.75" />
    </pattern>
    <pattern id="hero-halftone" patternUnits="userSpaceOnUse" width="5" height="5">
      <circle cx="2.5" cy="2.5" r="0.6" fill="currentColor" />
    </pattern>
    <pattern id="hero-grid" patternUnits="userSpaceOnUse" width="10" height="10">
      <path d="M10 0 V10 H0" fill="none" stroke="currentColor" stroke-width="0.5" />
    </pattern>
    <g id="hero-wing">
      <path
        d="M16 72 L16 148 L40 148 L40 108 L64 108 L64 72 Z"
        fill="url(#hero-hatch-h)"
        stroke="currentColor"
        stroke-width="1"
      />
      <path
        d="M24 156 L24 176 L48 176 L48 156 Z"
        fill="currentColor"
        stroke="currentColor"
        stroke-width="1"
      />
      <path
        d="M28 300 L28 368 L52 368 L52 328 L76 328 L76 300 Z"
        fill="url(#hero-halftone)"
        stroke="currentColor"
        stroke-width="1"
      />
      <polygon points="40,196 76,228 40,260" fill="url(#hero-hatch-d)" stroke="currentColor" stroke-width="1" />
      <polygon points="52,212 72,228 52,244" fill="currentColor" />
      <circle cx="88" cy="228" r="10" fill="none" stroke="currentColor" stroke-width="1" />
      <rect x="87" y="222" width="2" height="12" fill="currentColor" />
      <rect x="82" y="227" width="12" height="2" fill="currentColor" />
      <line x1="96" y1="228" x2="148" y2="228" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 3" />
      <line x1="40" y1="88" x2="148" y2="88" stroke="currentColor" stroke-width="0.75" />
      <rect x="146" y="86" width="4" height="4" fill="currentColor" />
      <polygon points="148,368 156,380 140,380" fill="currentColor" />
    </g>
    <g id="hero-star-row">
      <polygon points="0,0 4,7 8,0" fill="currentColor" />
      <polygon points="10,0 14,7 18,0" fill="currentColor" />
      <polygon points="20,0 24,7 28,0" fill="currentColor" />
    </g>
  </defs>

  <rect x="0.5" y="0.5" width="359" height="479" fill="none" stroke="currentColor" stroke-width="1" />

  <g transform="translate(180 240) scale(1.28) translate(-180 -240)">
    <line x1="180" y1="12" x2="180" y2="468" stroke="currentColor" stroke-width="0.5" stroke-dasharray="3 5" />
    <line x1="12" y1="240" x2="348" y2="240" stroke="currentColor" stroke-width="0.5" stroke-dasharray="3 5" />

    <polygon points="180,28 228,76 132,76" fill="url(#hero-hatch-h)" stroke="currentColor" stroke-width="1" />
    <polygon points="180,40 212,72 148,72" fill="currentColor" />

    <use href="#hero-wing" />
    <use href="#hero-wing" transform="translate(360,0) scale(-1,1)" />

    <polygon points="180,108 204,132 156,132" fill="none" stroke="currentColor" stroke-width="1" />
    <rect x="178" y="106" width="4" height="4" fill="currentColor" />

    <use href="#hero-star-row" transform="translate(150, 92)" />
    <use href="#hero-star-row" transform="translate(182, 92)" />

    <polygon points="180,168 248,236 112,236" fill="url(#hero-hatch-v)" stroke="currentColor" stroke-width="1.25" />
    <polygon points="180,184 228,232 132,232" fill="currentColor" />

    <rect x="168" y="248" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1" />
    <rect x="176" y="256" width="8" height="8" fill="currentColor" />

    <line x1="124" y1="280" x2="236" y2="280" stroke="currentColor" stroke-width="0.75" />
    <rect x="122" y="278" width="4" height="4" fill="currentColor" />
    <rect x="234" y="278" width="4" height="4" fill="currentColor" />

    <polygon points="180,388 220,428 180,468 140,428" fill="url(#hero-grid)" stroke="currentColor" stroke-width="1" />
    <polygon points="180,404 204,428 180,452 156,428" fill="currentColor" />

    <rect x="48" y="448" width="264" height="8" fill="url(#hero-hatch-h)" stroke="currentColor" stroke-width="1" />
    <rect x="80" y="460" width="200" height="6" fill="currentColor" />

    <line x1="64" y1="456" x2="296" y2="456" stroke="currentColor" stroke-width="0.5" stroke-dasharray="1 4" />
  </g>
</svg>
