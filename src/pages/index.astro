---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const projectEntries = await getCollection("projects");
const experienceEntries = await getCollection("experiences");

const projects = projectEntries.map((p) => p.data).sort((a, b) => a.order - b.order);
const experiences = experienceEntries.map((e) => e.data).sort((a, b) => a.order - b.order);

const skills = [
  "Product Strategy",
  "Product Vision",
  "Product Roadmap",
  "Platform Engineering",
  "Artificial Intelligence",
  "Developer Experience",
  "Software Development Lifecycle",
  "Infrastructure-as-Code",
  "Backlog Management",
  "User Research",
  "Agile Methodologies",
];

const strengths = [
  {
    title: "Systems thinking",
    description:
      "Connects immediate decisions to long-term outcomes. Sees several steps ahead without losing sight of today.",
  },
  {
    title: "Team enabler",
    description:
      "Leads by enabling others \u2014 aligning teams toward a shared north star without needing formal authority.",
  },
  {
    title: "Quick study",
    description:
      "Active listener with high-bandwidth information intake. New concepts stick quickly.",
  },
];
---

<BaseLayout title="Jonathan Gabor">
  <Nav />
  <main id="main-content">
    <Hero />

    <ProjectGrid projects={projects} />

    <section class="experience relative py-24 md:py-36" id="experience">
      <div class="relative mx-auto max-w-[1100px] px-6 md:px-8">
        <div class="mb-16">
          <span class="eyebrow">Experience</span>
          <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-foreground md:text-4xl">15+ years building products</h2>
          <p class="mt-3 max-w-lg text-lg text-muted">
            I am relentless about creating intuitive and simple products in complex technical
            environments, with users' needs at the forefront.
          </p>
        </div>

        <div class="mb-20 flex flex-col gap-4">
          {strengths.map((s) => (
            <div class="fade-in bezel-shell">
              <div class="bezel-core p-6 md:p-8">
                <h3 class="font-mono text-xs uppercase tracking-[0.15em] text-muted">{s.title}</h3>
                <p class="mt-3 text-base leading-relaxed text-muted">{s.description}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mb-20 fade-in">
          <p class="mb-4 font-mono text-xs uppercase tracking-[0.15em] text-muted">Skills</p>
          <div class="flex flex-wrap gap-2">
            {skills.map((skill) => (
              <span class="border border-overlay/12 px-3 py-1.5 font-mono text-xs uppercase tracking-[0.05em] text-muted">{skill}</span>
            ))}
          </div>
        </div>

        <div class="flex flex-col gap-16">
          {experiences.map((exp) => (
            <ExperienceItem
              company={exp.company}
              tenure={exp.tenure}
              roles={exp.roles}
            />
          ))}
        </div>
      </div>
    </section>

    <ContactForm />
  </main>
  <Footer />
</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );

  document.querySelectorAll(".fade-in").forEach((el) => {
    observer.observe(el);
  });
</script>
