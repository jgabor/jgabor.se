---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";
import SectionShell from "../components/SectionShell.astro";
import { getCollection } from "astro:content";

const projectEntries = await getCollection("projects");
const experienceEntries = await getCollection("experiences");

const projects = projectEntries.map((p) => p.data).sort((a, b) => a.order - b.order);
const experiences = experienceEntries.map((e) => e.data).sort((a, b) => a.order - b.order);

const skills = [
  "Product Strategy",
  "Product Vision",
  "Product Roadmap",
  "Platform Engineering",
  "Artificial Intelligence",
  "Developer Experience",
  "Software Development Lifecycle",
  "Infrastructure-as-Code",
  "Backlog Management",
  "User Research",
  "Agile Methodologies",
];

const strengths = [
  {
    title: "Systems thinking",
    description:
      "Connects immediate decisions to long-term outcomes. Sees several steps ahead without losing sight of today.",
  },
  {
    title: "Team enabler",
    description:
      "Leads by enabling others \u2014 aligning teams toward a shared north star without needing formal authority.",
  },
  {
    title: "Quick study",
    description:
      "Active listener with high-bandwidth information intake. New concepts stick quickly.",
  },
];
---

<BaseLayout title="Jonathan Gabor">
  <Nav />
  <main id="main-content">
    <Hero />

    <ProjectGrid projects={projects} />

    <SectionShell
      id="experience"
      eyebrow="Experience"
      title="15+ years building products"
      subtitle="I am relentless about creating intuitive and simple products in complex technical environments, with users' needs at the forefront."
      showConnector
    >
      <div class="mb-16 grid gap-4 md:grid-cols-3">
        {strengths.map((s) => (
          <div class="strength-card fade-in">
            <h3 class="font-mono text-xs uppercase tracking-[0.15em] text-muted">{s.title}</h3>
            <p class="mt-3 text-base leading-relaxed">{s.description}</p>
          </div>
        ))}
      </div>

      <div class="mb-16 fade-in">
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.15em] text-muted">Skills</p>
        <div class="flex flex-wrap gap-2">
          {skills.map((skill) => (
            <span class="chip">{skill}</span>
          ))}
        </div>
      </div>

      <ExperienceTimeline experiences={experiences} />
    </SectionShell>

    <ContactForm />
  </main>
  <Footer />
</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );

  document.querySelectorAll(".fade-in").forEach((el) => {
    observer.observe(el);
  });
</script>
