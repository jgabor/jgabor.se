---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/jgabor.jpg';
import { getCollection } from "astro:content";

const careerEntries = await getCollection("career");
const career = careerEntries.map((e) => e.data).sort((a, b) => a.order - b.order);
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="Jonathan Gabor — Product Owner bridging engineering and product to ship intuitive solutions. Passionate about AI, open source, and making things 1% better every day."
		/>
		<title>Jonathan Gabor — Product Owner</title>
		<style>
			:root {
				--color-ink: #0a0a0a;
				--color-ink-soft: #2a2a2a;
				--color-ink-muted: #666666;
				--color-paper: #ffffff;
				--color-paper-off: #f5f5f5;
				--color-accent: #e63312;
				--color-rule: #0a0a0a;
				--font-main: 'Noto IKEA', 'Noto Sans', -apple-system, sans-serif;
				--space-unit: 8px;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			html {
				font-size: calc(var(--space-unit) * 2);
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			body {
				font-family: var(--font-main);
				background: var(--color-paper-off);
				color: var(--color-ink);
				line-height: 1.6;
				min-height: 100vh;
			}

			.page {
				max-width: calc(var(--space-unit) * 120);
				margin: 0 auto;
				background: var(--color-paper);
				min-height: 100vh;
				position: relative;
			}

			/* Header Section - Brutalist */
			.header {
				background: var(--color-ink);
				color: var(--color-paper);
				padding: calc(var(--space-unit) * 5) calc(var(--space-unit) * 5);
				position: relative;
			}

			.header-content {
				display: grid;
				grid-template-columns: 1fr auto auto;
				gap: calc(var(--space-unit) * 4);
				align-items: center;
			}

			/* Profile Photo */
			.profile-photo {
				width: calc(var(--space-unit) * 14);
				height: auto;
				object-fit: cover;
				border: 1px solid var(--color-ink-muted);
			}

			.name-block {
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.name {
				font-size: 3rem;
				font-weight: 700;
				letter-spacing: -0.04em;
				line-height: 1;
				margin-bottom: calc(var(--space-unit) * 1.5);
				text-transform: uppercase;
			}

			.title {
				font-size: 1rem;
				font-weight: 500;
				color: var(--color-accent);
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.location {
				font-size: 0.85rem;
				font-weight: 400;
				color: rgba(255, 255, 255, 0.5);
				margin-top: calc(var(--space-unit) * 0.5);
				letter-spacing: 0.02em;
			}

			.contact-block {
				text-align: left;
				font-size: 0.85rem;
				border-left: 1px solid rgba(255, 255, 255, 0.2);
				padding-left: calc(var(--space-unit) * 3);
			}

			.contact-block a {
				color: var(--color-paper);
				text-decoration: none;
				display: block;
				padding: calc(var(--space-unit) * 0.5) 0;
				transition: color 0.15s ease;
				font-weight: 400;
			}

			.contact-block a:hover {
				color: var(--color-accent);
			}

			.contact-block .download-button {
				display: inline-block;
				background: var(--color-accent);
				color: var(--color-paper);
				padding: calc(var(--space-unit) * 1) calc(var(--space-unit) * 2);
				margin-top: calc(var(--space-unit) * 1.5);
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				transition: background 0.15s ease, color 0.15s ease;
			}

			.contact-block .download-button:hover {
				background: var(--color-paper);
				color: var(--color-accent);
			}

			/* Main Content */
			.main {
				padding: calc(var(--space-unit) * 5);
			}

			/* Summary Section */
			.summary {
				padding-bottom: calc(var(--space-unit) * 5);
				margin-bottom: calc(var(--space-unit) * 5);
				border-bottom: 2px solid var(--color-ink);
			}

			.summary p {
				font-size: 1.05rem;
				line-height: 1.7;
				color: var(--color-ink-soft);
				margin-bottom: calc(var(--space-unit) * 2);
			}

			.summary p:last-child {
				margin-bottom: 0;
				font-weight: 500;
				color: var(--color-ink);
			}

			/* Section Styling */
			.section {
				margin-bottom: calc(var(--space-unit) * 5);
			}

			.section-title {
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--color-ink);
				margin-bottom: calc(var(--space-unit) * 3);
				padding-bottom: calc(var(--space-unit) * 1);
				border-bottom: 1px solid var(--color-ink);
				display: inline-block;
			}

			.section-title::after {
				display: none;
			}

			/* Strengths Section */
			.strengths-section {
				margin-bottom: calc(var(--space-unit) * 5);
			}

			.strengths-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0;
				border: 1px solid var(--color-ink);
			}

			.career-strength {
				background: var(--color-paper);
				padding: calc(var(--space-unit) * 2.5);
				border-right: 1px solid var(--color-ink);
			}

			.career-strength:last-child {
				border-right: none;
			}

			.strength-title {
				font-size: 0.8rem;
				font-weight: 700;
				color: var(--color-ink);
				margin-bottom: calc(var(--space-unit) * 1);
				letter-spacing: 0.02em;
				text-transform: uppercase;
			}

			.strength-desc {
				font-size: 0.85rem;
				line-height: 1.6;
				color: var(--color-ink-soft);
			}

			/* Experience Entries */
			.company-block {
				margin-bottom: calc(var(--space-unit) * 5);
				padding-bottom: calc(var(--space-unit) * 4);
				border-bottom: 1px solid #e0e0e0;
			}

			.company-block:last-child {
				border-bottom: none;
				padding-bottom: 0;
			}

			.company-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: calc(var(--space-unit) * 2);
				flex-wrap: wrap;
				gap: calc(var(--space-unit) * 1);
			}

			.company-name {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--color-ink);
				letter-spacing: -0.02em;
				text-transform: uppercase;
			}

			.company-tenure {
				font-size: 0.75rem;
				color: var(--color-ink-muted);
				font-weight: 500;
				letter-spacing: 0.05em;
			}

			.role {
				margin-bottom: calc(var(--space-unit) * 4);
				padding-left: calc(var(--space-unit) * 2);
				border-left: 3px solid var(--color-accent);
			}

			.role:last-child {
				margin-bottom: 0;
			}

			.role-header {
				margin-bottom: calc(var(--space-unit) * 1.5);
			}

			.role-title {
				font-size: 1rem;
				font-weight: 600;
				color: var(--color-ink);
			}

			.role-meta {
				font-size: 0.8rem;
				color: var(--color-ink-muted);
				font-weight: 400;
			}

			.role-description {
				font-size: 0.9rem;
				line-height: 1.7;
				color: var(--color-ink-soft);
			}

			.role-description p {
				margin-bottom: calc(var(--space-unit) * 1.5);
			}

			.role-description p:last-child {
				margin-bottom: 0;
			}

			/* Skills & Languages */
			.meta-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: calc(var(--space-unit) * 4);
			}

			.meta-section h3 {
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--color-ink);
				margin-bottom: calc(var(--space-unit) * 1.5);
			}

			.tag-list {
				display: flex;
				flex-wrap: wrap;
				gap: calc(var(--space-unit) * 1);
			}

			.tag {
				background: transparent;
				color: var(--color-ink-soft);
				padding: calc(var(--space-unit) * 0.5) calc(var(--space-unit) * 1.5);
				font-size: 0.825rem;
				font-weight: 500;
				border: 1px solid var(--color-ink);
			}

			/* Footer accent */
			.footer-accent {
				height: 6px;
				background: var(--color-ink);
				margin-top: calc(var(--space-unit) * 4);
			}

			/* Page break */
			.page-break {
				border: none;
				border-top: 1px solid #e0e0e0;
				margin: calc(var(--space-unit) * 4) 0;
			}

			/* Meta section when at top */
			.meta-section-top {
				margin-bottom: calc(var(--space-unit) * 4);
			}

			/* Print Styles */
			@media print {
				@page {
					size: A4;
					margin-top: 10mm;
					margin-right: 10mm;
					margin-bottom: 10mm;
					margin-left: 10mm;
				}

				html,
				body {
					font-size: 10pt;
					background: white;
					-webkit-print-color-adjust: exact;
					print-color-adjust: exact;
				}

				.page {
					max-width: none;
					box-shadow: none;
				}

				/* Force desktop layout in print - override mobile styles */
				body .header {
					padding: 8mm 6mm;
					background: var(--color-ink);
					-webkit-print-color-adjust: exact;
					print-color-adjust: exact;
				}

				body .header-content {
					display: grid;
					grid-template-columns: 1fr auto auto;
					gap: 4mm;
					align-items: center;
					text-align: left;
				}

				body .profile-photo {
					width: 18mm;
					height: auto;
					margin: 0;
				}

				body .name-block {
					align-items: flex-start;
				}

				body .name {
					font-size: 20pt;
					text-align: left;
				}

				body .title {
					font-size: 9pt;
				}

				body .location {
					font-size: 8pt;
				}

				body .contact-block {
					text-align: left;
					border-left: 1px solid rgba(255, 255, 255, 0.2);
					border-top: none;
					padding-left: 3mm;
					padding-top: 0;
					font-size: 8pt;
				}

				body .contact-block a {
					color: var(--color-paper);
					padding: 0.5mm 0;
				}

				.contact-block .download-button {
					display: none;
				}

				/* Main content adjustments */
				.main {
					padding: 5mm 0 0 0;
				}

				.summary {
					padding-bottom: 4mm;
					margin-bottom: 4mm;
				}

				.summary p {
					font-size: 9.5pt;
					margin-bottom: 2mm;
				}

				/* Force desktop strengths grid */
				.strengths-section {
					break-inside: avoid;
					page-break-inside: avoid;
					margin-bottom: 4mm;
				}

				body .strengths-grid {
					display: grid;
					grid-template-columns: repeat(3, 1fr);
					break-inside: avoid;
					page-break-inside: avoid;
				}

				body .career-strength {
					padding: 3mm;
					border-right: 1px solid var(--color-ink);
					border-bottom: none;
				}

				body .career-strength:last-child {
					border-right: none;
				}

				.strength-title {
					font-size: 7.5pt;
				}

				.strength-desc {
					font-size: 8pt;
				}

				/* Force desktop meta grid */
				.meta-section-top {
					break-inside: avoid;
					page-break-inside: avoid;
					margin-bottom: 4mm;
				}

				body .meta-grid {
					display: grid;
					grid-template-columns: 1fr;
					gap: 4mm;
				}

				.meta-section h3 {
					font-size: 6.5pt;
				}

				.tag {
					font-size: 7.5pt;
					padding: 0.5mm 1.5mm;
				}

				/* Force desktop company header */
				body .company-header {
					display: flex;
					flex-direction: row;
					justify-content: space-between;
					align-items: baseline;
				}

				/* Experience adjustments */
				.section-title {
					font-size: 6.5pt;
					margin-bottom: 3mm;
				}

				.company-block {
					margin-bottom: 4mm;
					padding-bottom: 4mm;
					break-inside: avoid;
					page-break-inside: avoid;
				}

				.company-name {
					font-size: 11pt;
				}

				.company-tenure {
					font-size: 7.5pt;
				}

				.role {
					margin-bottom: 3mm;
					padding-left: 2.5mm;
					border-left-width: 2px;
					break-inside: avoid;
					page-break-inside: avoid;
				}

				.role-title {
					font-size: 9pt;
				}

				.role-meta {
					font-size: 7.5pt;
				}

				.role-description {
					font-size: 8.5pt;
				}

				.role-description p {
					margin-bottom: 1.5mm;
				}

				/* Page break marker */
				.page-break {
					margin: 3mm 0;
					break-before: page;
				}

				/* Hide footer accent in print */
				.footer-accent {
					display: none;
				}
			}

			/* Responsive */
			@media (max-width: 768px) {
				.header {
					padding: calc(var(--space-unit) * 4);
				}

				.header-content {
					grid-template-columns: 1fr;
					gap: calc(var(--space-unit) * 3);
					text-align: center;
				}

				.profile-photo {
					width: 90px;
					height: 90px;
					margin: 0 auto;
				}

				.name-block {
					align-items: center;
				}

				.name {
					font-size: 2rem;
				}

				.contact-block {
					text-align: center;
					border-left: none;
					padding-left: 0;
					border-top: 1px solid rgba(255, 255, 255, 0.2);
					padding-top: calc(var(--space-unit) * 2);
				}

				.main {
					padding: calc(var(--space-unit) * 3);
				}

				.strengths-grid {
					grid-template-columns: 1fr;
				}

				.career-strength {
					border-right: none;
					border-bottom: 1px solid var(--color-ink);
				}

				.career-strength:last-child {
					border-bottom: none;
				}

				.meta-grid {
					grid-template-columns: 1fr;
				}

				.company-header {
					flex-direction: column;
					align-items: flex-start;
				}
			}
		</style>
	</head>

	<body>
		<div class="page">
			<header class="header">
				<div class="header-content">
					<div class="name-block">
						<h1 class="name">Jonathan Gabor</h1>
						<p class="title">Speaks Code, Ships Product</p>
						<p class="location">Malm&ouml;, Sweden</p>
					</div>
					<Image src={heroPhoto} alt="Jonathan Gabor" class="profile-photo" />
					<div class="contact-block">
						<a href="mailto:jonathan@jgabor.se">jonathan@jgabor.se</a>
						<a href="https://linkedin.com/in/jgabor">linkedin.com/in/jgabor</a>
						<a href="https://jgabor.se">jgabor.se</a>
						<a href="/CV-Jonathan_Gabor.pdf" download class="download-button">Download PDF</a>
					</div>
				</div>
			</header>

			<main class="main">
				<section class="summary">
					<p>I am relentless about creating intuitive and simple products in a complex and technological environment.</p>
					<p>
						With equal parts engineering and product, I use my experiences from both worlds to create solutions that are delightful for
						customers to use, with incremental improvements driven by their feedback. My goal is to make everyone and everything 1% better
						every day.
					</p>
					<p>
						A long-standing passion for open source has shaped how I think about platforms: transparency, community collaboration, and
						reducing friction for developer contributions.
					</p>
					<p>
						The last couple of years, I have been deep down the AI rabbit hole, exploring AI-assisted software development, agentic
						workflows, and the interfaces and touch points between humans and artificial intelligence.
					</p>
					<p><strong>My opinion changes with new information.</strong></p>
				</section>

				<section class="section strengths-section">
					<h2 class="section-title">Strengths</h2>
					<div class="strengths-grid">
						<div class="career-strength">
							<h3 class="strength-title">Systems Thinking</h3>
							<p class="strength-desc">
								Connects immediate decisions to long-term outcomes. Sees several steps ahead without losing sight of today.
							</p>
						</div>
						<div class="career-strength">
							<h3 class="strength-title">Team Enabler</h3>
							<p class="strength-desc">
								Leads by enabling others---aligning teams toward a shared north star without needing formal authority.
							</p>
						</div>
						<div class="career-strength">
							<h3 class="strength-title">Quick Study</h3>
							<p class="strength-desc">Active listener with high-bandwidth information intake. New concepts stick quickly.</p>
						</div>
					</div>
				</section>

				<section class="section meta-section-top">
					<div class="meta-grid">
						<div class="meta-section">
							<h3>Skills</h3>
							<div class="tag-list">
								<span class="tag">Product Strategy</span>
								<span class="tag">Product Vision</span>
								<span class="tag">Product Roadmap</span>
								<span class="tag">Platform Engineering</span>
								<span class="tag">Artificial Intelligence</span>
								<span class="tag">Developer Experience</span>
								<span class="tag">Software Development Lifecycle</span>
								<span class="tag">Infrastructure-as-Code</span>
								<span class="tag">OKRs</span>
								<span class="tag">Backlog Management</span>
								<span class="tag">User Research</span>
								<span class="tag">Cross-functional Leadership</span>
								<span class="tag">Agile Methodologies</span>
							</div>
						</div>
					</div>
				</section>
				<section class="section meta-section-top">
					<div class="meta-grid">
						<div class="meta-section">
							<h3>Languages</h3>
							<div class="tag-list">
								<span class="tag">Swedish</span>
								<span class="tag">English</span>
							</div>
						</div>
					</div>
				</section>

				<hr class="page-break" />

				<section class="section">
					<h2 class="section-title">Experience</h2>

					{career.map((exp) => (
						<div class="company-block">
							<div class="company-header">
								<span class="company-name">{exp.company}</span>
								{exp.tenure && <span class="company-tenure">{exp.tenure}</span>}
							</div>
							{exp.roles.map((role) => (
								<div class="role">
									<div class="role-header">
										<h3 class="role-title">{role.title}</h3>
										<p class="role-meta">{role.period}{role.location ? ` \u00B7 ${role.location}` : ""}</p>
									</div>
									<div class="role-description">
										{(role.cvDescription ?? role.description).map((paragraph) => (
											<p>{paragraph}</p>
										))}
									</div>
								</div>
							))}
						</div>
					))}
				</section>
			</main>
			<div class="footer-accent"></div>
		</div>
	</body>
</html>
