{
  "name": "jgaborse",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom entry that adds Accept negotiation for pages with a markdown version.
  "main": "./src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    // Must match the keys of MARKDOWN_ALTERNATES in src/lib/markdown/negotiation.ts.
    "run_worker_first": ["/", "/cv/"],
  },
  "routes": [
    {
      "pattern": "jgabor.se",
      "zone_name": "jgabor.se",
      "custom_domain": true,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SITE",
      "id": "1a1a35272f0642c5b364ee7d0f377a03",
      "preview_id": "8607e5db8e29459e9c2bd502e882f92f",
    },
  ],
}
