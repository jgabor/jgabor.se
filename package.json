{
  "name": "jgaborse",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node tools/subset-fonts.mjs",
    "dev": "astro dev",
    "prebuild": "node tools/subset-fonts.mjs",
    "build": "astro build",
    "postbuild": "node tools/render-cv-pdf.mjs && node tools/perf-budget.mjs",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "analyze": "astro build && rollup-plugin-visualizer --open",
    "type-check": "astro check",
    "lint": "vp lint src/",
    "fmt": "vp fmt src/",
    "check": "vp check",
    "test": "node --experimental-strip-types --test src/lib/github/code-feed.test.ts src/lib/cv-pdf.test.ts src/utils/career-tenure.test.ts tools/report-code-feed.test.mjs",
    "subset:fonts": "node tools/subset-fonts.mjs",
    "perf:budget": "node tools/perf-budget.mjs",
    "cv:pdf": "node tools/render-cv-pdf.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@voidzero-dev/vite-plus-core": "^1.0.0",
    "lightningcss": "^1.33.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.63.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.0.0",
    "vite-plus": "^1.0.0",
    "wrangler": "^4.144.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@^1.0.0",
      "vitest": "5.0.1",
      "postcss": ">=8.5.23",
      "undici": ">=8.5.0",
      "ws": ">=8.21.0",
      "yaml": ">=2.8.3"
    }
  }
}
