{
  "name": "jgaborse",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node tools/subset-fonts.mjs",
    "dev": "astro dev",
    "prebuild": "node tools/subset-fonts.mjs",
    "build": "astro build",
    "postbuild": "node tools/render-cv-pdf.mjs && node tools/perf-budget.mjs",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "analyze": "astro build && rollup-plugin-visualizer --open",
    "type-check": "astro check",
    "lint": "vp lint src/",
    "fmt": "vp fmt src/",
    "check": "vp check",
    "test": "node --experimental-strip-types --test src/lib/github/code-feed.test.ts src/lib/cv-pdf.test.ts",
    "subset:fonts": "node tools/subset-fonts.mjs",
    "perf:budget": "node tools/perf-budget.mjs",
    "cv:pdf": "node tools/render-cv-pdf.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "astro": "^6.4.6",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@voidzero-dev/vite-plus-core": "^0.1.24",
    "lightningcss": "^1.32.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.60.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.24",
    "vite-plus": "^0.1.24",
    "wrangler": "^4.99.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.24",
      "devalue": ">=5.6.4",
      "undici": ">=7.24.0",
      "yaml": ">=2.8.3"
    }
  }
}
