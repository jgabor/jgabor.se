{
	"name": "jgaborse",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "bun run src/build.ts",
		"build:watch": "bun --watch run src/build.ts",
		"deploy": "bun run build && wrangler deploy && bun run kv-put",
		"dev": "bun run build:watch & bun run web",
		"dev:remote": "wrangler dev --remote",
		"web": "wrangler dev",
		"kv-put": "wrangler kv bulk put --namespace-id 1a1a35272f0642c5b364ee7d0f377a03 --remote dist/kv-entries.json"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251209.0",
		"bun-types": "latest",
		"wrangler": "^4.53.0"
	}
}
